  Provider.[ Claude ChatGpt ]
  Permission.[ Restricted Unrestricted ]
  Effort.[ Low Medium High Xhigh ]
  Surface.[ ClaudeAgent CodexAgent PiAgent ]
  ModelChoice.{ Text Option<Effort> }
  RoleModule.{ Text Text }
  Model.{ Text Provider Vector<Effort> }
  RolePermission.{ Text Text Permission }
  RoleDepth.{ Text ModelChoice ModelChoice }
  RoleDescription.{ Text Text Text }
  RoleAlias.{ Text Text Text Text Vector<Surface> }
  TargetInsertion.{ Text Surface Vector<Text> }
  Roles.{ Vector<RoleModule> Vector<Model> Vector<RolePermission> Vector<RoleDepth> Vector<RoleDescription> Vector<RoleAlias> Vector<Text> Vector<TargetInsertion> } ]

